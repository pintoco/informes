NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elemental_pro
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# JWT (mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=24h

# S3 / S3 compatible (en local: SeaweedFS de docker-compose.local.yml)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PHOTOS=elemental-photos
S3_BUCKET_PDFS=elemental-pdfs
# false cuando los buckets ya existen y el usuario no tiene permisos de administración (AWS)
S3_INIT_BUCKETS=true
# Duración de las URLs firmadas de fotos/PDFs (segundos)
SIGNED_URL_TTL_SECONDS=7200
