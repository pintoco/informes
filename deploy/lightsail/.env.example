# ── Elemental Pro — Lightsail ──────────────────────────────────────────
# Copiar a .env y completar. Generar claves con:  openssl rand -hex 32
# .env NUNCA se sube a Git (ya está en .gitignore).

# Dominio público (el DNS debe apuntar a la IP estática de Lightsail)
DOMAIN=informes.elementalpro.cl

# PostgreSQL
DB_USER=elemental
DB_NAME=elemental_pro
DB_PASSWORD=

# JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Amazon S3 — valores que imprime scripts/create-aws-resources.sh
AWS_REGION=us-east-1
S3_BUCKET_PHOTOS=
S3_BUCKET_PDFS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
